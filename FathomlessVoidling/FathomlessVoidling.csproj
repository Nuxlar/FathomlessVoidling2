<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>preview</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RunPostBuildEvent>Always</RunPostBuildEvent>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>portable</DebugType>
  </PropertyGroup>

	<PropertyGroup>
		<BuildDir>$(SolutionDir)build/</BuildDir>
		<TSPackageDir>$(BuildDir)/package/</TSPackageDir>
		<TSPackagePluginDir>$(TSPackageDir)/plugins/$(SolutionName)/</TSPackagePluginDir>
	</PropertyGroup>

  <ItemGroup>
    <Compile Remove="libs\**" />
    <EmbeddedResource Remove="libs\**" />
    <None Remove="libs\**" />
    <None Remove="libs\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.0.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <PackageReference Include="RiskOfRain2.GameLibs" Version="*-*" GeneratePathProperty="true" />
    <PackageReference Include="MMHOOK.RoR2" Version="*" NoWarn="NU1701" />
    <PackageReference Include="RoR2BepInExPack" Version="*" />
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.45" GeneratePathProperty="true" />
    <PackageReference Include="R2API.Core" Version="5.3.0" />
    <PackageReference Include="R2API.Prefab" Version="1.1.1" />
    <PackageReference Include="R2API.ContentManagement" Version="1.1.0" />
    <PackageReference Include="R2API.DamageType" Version="1.1.7" />
  </ItemGroup>
  
 <ItemGroup>
    <Reference Include="Unity.Timeline">
      <HintPath>libs\Unity.Timeline.dll</HintPath>
    </Reference>
    <Reference Include="Unity.Postprocessing.Runtime">
      <HintPath>libs\Unity.Postprocessing.Runtime.dll</HintPath>
    </Reference>
        <Reference Include="RiskOfOptions">
      <HintPath>libs\RiskOfOptions.dll</HintPath>
    </Reference>
  </ItemGroup>

 <Target Name="BuildTSPackage" AfterTargets="Build">
    <MakeDir Directories="$(TSPackageDir);$(TSPackagePluginDir)" />
    <Copy SourceFiles="$(SolutionDir)manifest.json;$(SolutionDir)README.md;$(SolutionDir)CHANGELOG.md" DestinationFolder="$(TSPackageDir)" />

    <Copy SourceFiles="$(BuildDir)icon.png" DestinationFolder="$(TSPackageDir)" ContinueOnError="true" />
    <Copy SourceFiles="$(BuildDir)icon.png" DestinationFolder="$(TSPackagePluginDir)" ContinueOnError="true" />

    <Delete Files="$(TSPackagePluginDir)/$(AssemblyName).dll" />
    <Delete Files="$(TSPackagePluginDir)/$(AssemblyName).pdb" Condition="'$(Configuration)'=='Release'" ContinueOnError="true" />

    <!--Weaver is a .NET Framework exe: run it through mono off Windows-->
    <PropertyGroup>
      <NetWeaverRunner Condition="'$(OS)' != 'Windows_NT'">mono </NetWeaverRunner>
    </PropertyGroup>
     <Exec Command="$(NetWeaverRunner)Unity.UNetWeaver.exe &quot;$(PkgUnityEngine_Modules)/lib/netstandard2.0/UnityEngine.CoreModule.dll&quot; &quot;$(PkgRiskOfRain2_GameLibs)/lib/netstandard2.0/com.unity.multiplayer-hlapi.Runtime.dll&quot; &quot;$(TSPackagePluginDir)&quot; &quot;$(ProjectDir)$(OutDir)$(AssemblyName).dll&quot; &quot;$(NuGetPackageRoot)netstandard.library.ref/2.1.0/ref/netstandard2.1&quot;" WorkingDirectory="$(ProjectDir)NetworkWeaver" IgnoreStandardErrorWarningFormat="true" />
    <PropertyGroup>
      <NetWeaverHasOutput>false</NetWeaverHasOutput>
      <NetWeaverHasOutput Condition="Exists('$(TSPackagePluginDir)/$(AssemblyName).dll')">true</NetWeaverHasOutput>
    </PropertyGroup>

    <Copy SourceFiles="$(BuildDir)fathomlessvoidling.bundle" DestinationFolder="$(TSPackagePluginDir)" Condition="!$(NetWeaverHasOutput)"/>
    <Copy SourceFiles="$(OutDir)$(AssemblyName).dll" DestinationFolder="$(TSPackagePluginDir)" Condition="!$(NetWeaverHasOutput)" />
    <Copy SourceFiles="$(OutDir)$(AssemblyName).pdb" DestinationFolder="$(TSPackagePluginDir)" Condition="'$(Configuration)'=='Debug' And !$(NetWeaverHasOutput)" ContinueOnError="true" />

    <Delete Files="$(TSPackagePluginDir)/$(AssemblyName).dll.mdb" Condition="$(NetWeaverHasOutput)" ContinueOnError="true" />

    <!--Weaver messes up debug symbols, so they can't be used at all if it ran-->
    <Delete Files="$(TSPackagePluginDir)/$(AssemblyName).pdb" Condition="$(NetWeaverHasOutput)" ContinueOnError="true" />

    <ZipDirectory SourceDirectory="$(TSPackageDir)" DestinationFile="$(BuildDir)/$(SolutionName).zip" Overwrite="true" />
  </Target>

</Project>